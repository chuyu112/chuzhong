# Existing director model configuration is read locally; credentials are never copied.
# Optional path to an existing director project's model configuration:
# CUIYI_SOURCE_DIR=/absolute/path/to/director
# Or configure the selected provider directly:
GLM_API_KEY=
# Flova CLI project used for automatic study illustration generation.
# The server returns the explanation first, then adds the generated image when ready.
FLOVA_IMAGE_PROJECT_ID=
# Optional if the Flova CLI is already on PATH.
FLOVA_CLI_PATH=flova
# Doubao Voice API Key (separate from the Ark/chat key).
# Can also be set in .env.media.local. Never put it in dist/ or commit it.
DOUBAO_TTS_API_KEY=
EDU_PORT=3018
EDU_HOST=127.0.0.1
# Accounts are required on every host; users register with a phone number and password.
# For HTTPS reverse proxy deployments:
# EDU_COOKIE_SECURE=true
# Provision an administrator before exposing the app:
# EDU_ADMIN_PHONE=
# EDU_ADMIN_INITIAL_PASSWORD=

# LibTV CLI: log in on the host; keep credentials outside the repository.
LIBTV_VIDEO_ENABLED=false
LIBTV_CLI_PATH=libtv
# Optional directory containing credentials.json for the service account.
# LIBTV_CONFIG_DIR=/private/path/libtv
FFPROBE_PATH=ffprobe
